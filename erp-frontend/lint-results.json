   </td>\n              </tr>\n            ) : (\n              carts.map((cart) => {\n                const totalAmount = Array.isArray(cart.items) ? cart.items.reduce((sum: number, item: any) => sum + (item.price || 0) * (item.qty || 1), 0) : 0;\n                return (\n                  <tr key={cart.id} className=\"border-b border-border last:border-0 hover:bg-muted/20 transition-colors\">\n                    <td className=\"py-3 px-4 text-sm font-medium\">\n                      {cart.customer.name}\n                      <div className=\"text-xs text-muted-foreground font-normal\">\n                        {cart.customer.email && <div>{cart.customer.email}</div>}\n                        {cart.customer.phone && <div>{cart.customer.phone}</div>}\n                      </div>\n                    </td>\n                    <td className=\"py-3 px-4 text-sm text-muted-foreground\">\n                      {new Date(cart.drop_off_time).toLocaleString()}\n                    </td>\n                    <td className=\"py-3 px-4 text-sm\">\n                      <span className=\"text-xs font-medium bg-amber-100 text-amber-800 px-2 py-0.5 rounded-full capitalize\">\n                        {cart.status}\n                      </span>\n                    </td>\n                    <td className=\"py-3 px-4 text-sm\">\n                      <div className=\"bg-slate-50 p-2 rounded text-slate-700 max-h-24 overflow-y-auto\">\n                        {Array.isArray(cart.items) && cart.items.length > 0 ? (\n                          <ul className=\"list-disc pl-4 space-y-1 text-xs\">\n                            {cart.items.map((item: any, i: number) => (\n                              <li key={i}>\n                                {item.qty}x {item.name || `Variant #${item.variantId}`}\n                                <span className=\"text-muted-foreground ml-1\">\n                                  {item.size ? `[${item.size}]` : \"\"} {item.color ? `(${item.color})` : \"\"} - ₹{item.price || 0}\n                                </span>\n                              </li>\n                            ))}\n                          </ul>\n                        ) : (\n                          \"No items recorded\"\n                        )}\n                      </div>\n                    </td>\n                    <td className=\"py-3 px-4 text-sm font-semibold\">\n                      ₹{totalAmount.toLocaleString()}\n                    </td>\n                  </tr>\n                );\n              })\n            )}\n          </tbody>\n        </Table>\n      </div>\n    </Card>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"/Users/manojaaa/Silaa Website/erp-frontend/src/app/abandoned-carts/loading.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/manojaaa/Silaa Website/erp-frontend/src/app/abandoned-carts/page.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/manojaaa/Silaa Website/erp-frontend/src/app/api/revalidate/route.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/manojaaa/Silaa Website/erp-frontend/src/app/customers/AddCustomerForm.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/manojaaa/Silaa Website/erp-frontend/src/app/customers/BulkUploadCustomers.tsx","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":14,"column":52,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":1